{
  "name": "Nord",
  "description": "Arctic, north-bluish color palette",
  "palette": {
    "background": "#2e3440",
    "background_alt": "#3b4252",
    "background_dark": "#2e3440",
    "foreground": "#d8dee9",
    "foreground_dim": "#4c566a",
    "cursor": "#d8dee9",

    "black": "#3b4252",
    "red": "#bf616a",
    "green": "#a3be8c",
    "yellow": "#ebcb8b",
    "blue": "#81a1c1",
    "magenta": "#b48ead",
    "cyan": "#88c0d0",
    "white": "#e5e9f0",

    "bright_black": "#4c566a",
    "bright_red": "#bf616a",
    "bright_green": "#a3be8c",
    "bright_yellow": "#ebcb8b",
    "bright_blue": "#81a1c1",
    "bright_magenta": "#b48ead",
    "bright_cyan": "#8fbcbb",
    "bright_white": "#eceff4",

    "accent": "#ebcb8b",
    "accent_bright": "#ebcb8b",
    "border": "#88c0d0",
    "separator": "#3b4252",

    "surface0": "#2e3440",
    "surface1": "#3b4252",
    "surface2": "#434c5e"
  },
  "apps": {
    "neovim": {
      "colorscheme": "nord",
      "background": "dark"
    },
    "lualine": {
      "theme": "nord"
    },
    "ghostty": {
      "theme": "Nord"
    },
    "hyprpanel": {
      "theme_file": "hyprpanel.json"
    },
    "gtk": {
      "theme_name": "Nordic",
      "icon_theme": "breeze-dark",
      "cursor_theme": "Bibata-Modern-Ice",
      "note": "Install: yay -S nordic-theme"
    },
    "kvantum": {
      "theme_name": "KvArcDark",
      "note": "Install: yay -S kvantum (Nord uses built-in dark theme)"
    },
    "yazi": {
      "flavor": "nord"
    },
    "quickshell": {
      "font_family": "JetBrainsMono Nerd Font Mono"
    }
  },
  "pywal": {
    "apps": ["starship", "dunst"]
  }
