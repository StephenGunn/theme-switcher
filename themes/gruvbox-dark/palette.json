    },
    "kvantum": {
      "theme_name": "Gruvbox-Dark",
      "note": "Install: yay -S kvantum kvantum-theme-gruvbox-git"
    },
    "yazi": {
      "flavor": "gruvbox-dark"
    },
    "quickshell": {
      "font_family": "JetBrainsMono Nerd Font Mono"
    }
