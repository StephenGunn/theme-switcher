# Auto-generated by theme-switcher from pywal colors -- do not edit manually.
#
# Installed as ~/.config/dunst/dunstrc.d/99-colors.conf. Dunst loads drop-ins
# after the base dunstrc, most important last, so everything here overrides
# the fallback colors in the tracked dotfiles dunstrc.
#
# Colors only. Geometry, fonts, timeouts and mouse actions stay in the base
# dunstrc so that switching themes cannot change behaviour.

[global]
