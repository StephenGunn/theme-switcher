    separator_color = frame
    highlight = "{color4}"

[urgency_low]
    background = "{background}"
    foreground = "{foreground}"
    frame_color = "{color4}"
    highlight = "{color4}"

[urgency_normal]
    background = "{background}"
    foreground = "{foreground}"
    frame_color = "{color6}"
    highlight = "{color6}"

[urgency_critical]
    background = "{background}"
    foreground = "{foreground}"
    frame_color = "{color1}"
    highlight = "{color1}"
